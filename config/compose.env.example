# Local-development placeholders only. Never put production secrets in this file.
# Required command (the repository-root .env must not be used implicitly):
# docker compose --env-file config/compose.env.example up --build

# PostgreSQL image bootstrap variables. These are the only non-Settings names
# because the official PostgreSQL image requires them. CHANGE ALL THREE locally.
# The shared backend entrypoint URL-encodes them before setting DATABASE_URL.
POSTGRES_DB=epilepsy_dev
POSTGRES_USER=epilepsy_dev
POSTGRES_PASSWORD=CHANGE_ME_postgres_password

# These names exactly match app.config.Settings. Compose also maps them to the
# MinIO server's required MINIO_ROOT_* variables. CHANGE BOTH locally.
MINIO_ACCESS_KEY=CHANGE_ME_minio_access_key
MINIO_SECRET_KEY=CHANGE_ME_minio_secret_key
MINIO_DOCUMENTS_BUCKET=epilepsy-documents
MINIO_EVALUATIONS_BUCKET=epilepsy-evaluations

# Initial local admin. Both fields are required together; CHANGE BOTH locally.
ADMIN_BOOTSTRAP_USERNAME=CHANGE_ME_admin
ADMIN_BOOTSTRAP_PASSWORD=CHANGE_ME_admin_password

# Safe default stack: real PostgreSQL/MinIO/Qdrant plus the existing deterministic
# LLM/embedding mock logic. Keep MOCK_MODE=true for this container entrypoint; no
# external LLM endpoint, provider key, or fabricated model name is configured.
ENVIRONMENT=development
CORS_ORIGINS=["http://localhost:8080","http://127.0.0.1:8080"]
ENABLE_ADMIN_API=true
USE_QDRANT=true
MOCK_MODE=true
QDRANT_COLLECTION=epilepsy_hybrid_docs

# ingestion profile only. Set EMBED_MODEL_PATH to an existing absolute host
# directory containing BGE-M3 config and weights. Compose mounts it read-only and
# passes /models/bge-m3 to the worker under this same Settings field.
EMBED_MODEL_NAME=BAAI/bge-m3
EMBED_MODEL_PATH=/CHANGE_ME/absolute/path/to/bge-m3
