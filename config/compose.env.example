# Local-development placeholders only. Never put production secrets in this file.
# Required command (the repository-root .env must not be used implicitly):
# docker compose --env-file config/compose.env.example up --build

# PostgreSQL image bootstrap variables. CHANGE ALL THREE for non-demo use.
POSTGRES_DB=epilepsy_dev
POSTGRES_USER=epilepsy_dev
POSTGRES_PASSWORD=CHANGE_ME_postgres_password

# MinIO local credentials and buckets. CHANGE BOTH credentials for non-demo use.
MINIO_ACCESS_KEY=CHANGE_ME_minio_access_key
MINIO_SECRET_KEY=CHANGE_ME_minio_secret_key
MINIO_DOCUMENTS_BUCKET=epilepsy-documents
MINIO_EVALUATIONS_BUCKET=epilepsy-evaluations

# Initial local admin. Both fields are required together.
ADMIN_BOOTSTRAP_USERNAME=CHANGE_ME_admin
ADMIN_BOOTSTRAP_PASSWORD=CHANGE_ME_admin_password

ENVIRONMENT=development
CORS_ORIGINS=["http://localhost:8080","http://127.0.0.1:8080"]
ENABLE_ADMIN_API=true
USE_QDRANT=true
QDRANT_COLLECTION=epilepsy_hybrid_docs

# Legacy query rewrite, embedding and reranker fallbacks remain deterministic in
# the default stack. Streaming answer generation is controlled separately below.
MOCK_MODE=true

# demo: no model call; renders retrieved excerpts and labels them as Demo.
# openai_compatible: real streaming provider; missing key/model/endpoint fails closed.
CHAT_LLM_MODE=demo
DEEPSEEK_BASE_URL=
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=

# The default worker starts automatically and uses the same dependency-free
# MD5-token/TF vectors as the default API query path. It is not BGE-M3.
INGESTION_EMBEDDING_BACKEND=deterministic

# No controlled evaluator is bundled. Keep this false so the API refuses to
# create jobs that could never produce real metrics.
EVALUATION_RUNNER_ENABLED=false

# Optional bge-ingestion profile only. The default worker does not use this path.
# Stop the default worker before starting worker-bge, and provide real model files.
EMBED_MODEL_NAME=BAAI/bge-m3
EMBED_MODEL_PATH=/CHANGE_ME/absolute/path/to/bge-m3
