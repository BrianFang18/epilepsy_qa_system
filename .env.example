APP_NAME=Epilepsy Agentic RAG System
ENVIRONMENT=dev
HOST=0.0.0.0
PORT=8010

# ===================== 运行模式 =====================
# true: Mock 模式，不依赖真实模型，用于开发调试
# false: 生产模式，使用真实 vLLM 模型
MOCK_MODE=true

# ===================== vLLM 模型配置 =====================
# 小模型验证阶段（快速验证全链路）
LLM_API_BASE=http://127.0.0.1:8000/v1
LLM_API_KEY=EMPTY
# 小模型: Qwen/Qwen2.5-1.5B-Instruct
# 中模型: Qwen/Qwen2.5-7B-Instruct
# 大模型: Qwen/Qwen2.5-72B-Instruct-GPTQ (INT4 量化)
LLM_MODEL=Qwen/Qwen2.5-1.5B-Instruct
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1024

# ===================== 检索配置 =====================
EMBED_DIM=1024
DENSE_TOP_K=12
SPARSE_TOP_K=12
FINAL_TOP_K=6
# 混合检索权重：Dense(语义) + Sparse(关键词)
HYBRID_DENSE_WEIGHT=0.65
HYBRID_SPARSE_WEIGHT=0.35
RERANKER_TOP_K=5
MAX_CONTEXT_CHARS=5000

# ===================== 向量数据库 =====================
# false: 使用内存存储（开发用）
# true: 使用 Qdrant 向量数据库
USE_QDRANT=false
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=epilepsy_hybrid_docs

# ===================== 安全与推理模式 =====================
ALLOW_UNVERIFIED_MEDICAL_ADVICE=false
# CoT 推理模式:
# structured: CoT 增强版（4步显式推理，推荐生产使用）
# standard: 标准版（保留原有格式，用于对比实验）
COT_MODE=structured

# ===================== 管理面（PostgreSQL + MinIO） =====================
# 仅在数据库已执行 Alembic migration 后开启。
ENABLE_ADMIN_API=false
DATABASE_URL=postgresql+psycopg://epilepsy:change-me@127.0.0.1:5432/epilepsy
DATABASE_ECHO=false
DATABASE_POOL_SIZE=5
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=change-me
MINIO_SECURE=false
MINIO_DOCUMENTS_BUCKET=epilepsy-documents
MINIO_EVALUATIONS_BUCKET=epilepsy-evaluations

# 首次启动时创建管理员；创建完成后可移除这两个变量。
ADMIN_BOOTSTRAP_USERNAME=admin
ADMIN_BOOTSTRAP_PASSWORD=change-this-local-demo-password
ADMIN_SESSION_TTL_SECONDS=1800
ADMIN_COOKIE_SECURE=false
ADMIN_MAX_UPLOAD_BYTES=26214400

# 上传幂等键与 worker lease/retry。
INGESTION_PARSER_VERSION=mineru-parser-v1
INGESTION_CHUNKER_VERSION=parent-child-v1
INGESTION_INDEX_VERSION=qdrant-hybrid-rrf-v1
WORKER_POLL_SECONDS=2
WORKER_LEASE_SECONDS=300
WORKER_HEARTBEAT_SECONDS=30
WORKER_MAX_ATTEMPTS=3
WORKER_RETRY_BASE_SECONDS=30
EVALUATION_MAX_ATTEMPTS=2

# 浏览器 cookie 请求只允许显式来源；值必须是 JSON 数组。
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]